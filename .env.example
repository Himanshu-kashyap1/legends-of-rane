# Telegram Bot Configuration Template
BOT_TOKEN=your_telegram_bot_token_here

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/legends_of_rane

# Application Environment & Server Port
PORT=3000
NODE_ENV=development

# 3D Base Telegram Mini App URL (HTTPS Cloudflare Tunnel or Hosted Domain)
WEBAPP_URL=http://localhost:3000/webapp

# Optional: Admin Telegram User IDs (comma-separated)
ADMIN_IDS=

